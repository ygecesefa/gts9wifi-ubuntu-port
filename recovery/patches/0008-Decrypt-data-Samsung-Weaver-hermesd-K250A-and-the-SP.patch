index a7584dd..2e6e7c6 100644
--- a/recovery/root/init.recovery.qcom.rc
+++ b/recovery/root/init.recovery.qcom.rc
@@ -43,3 +43,4 @@ on boot
     start health-hal-2-1
 
 import /init.recovery.keymint.rc
+import /init.recovery.spu.rc
diff --git a/recovery/root/init.recovery.spu.rc b/recovery/root/init.recovery.spu.rc
new file mode 100644
index 0000000..bb01dba
--- /dev/null
+++ b/recovery/root/init.recovery.spu.rc
@@ -0,0 +1,44 @@
+# Samsung Weaver for /data decryption in recovery.  Android 15 protects
+# user 0's synthetic password with Weaver even without a lock screen; on
+# this tablet Weaver is hermesd, which talks to the K250A secure element
+# and to the SPU (spss).  The SPU is brought up as Android does it:
+# sec_nvm (NVM server) and spdaemon (loads the SPSS firmware and the SP
+# apps), with a tmpfs copy of Android's NVM (gts9wifi-spu-nvm.sh).
+#
+# The SPU starts once per boot and must never be restarted: sec_nvm and
+# spdaemon are oneshot.  hermesd gets no K250A firmware images
+# (/vendor/etc/secnvm is not in the ramdisk), so its secure element
+# update path has nothing to write; its logs go to /tmp/hermes instead of
+# /data/vendor/gatekeeper.
+
+on post-fs
+    exec u:r:recovery:s0 root root -- /system/bin/sh /system/bin/gts9wifi-spu-nvm.sh
+
+on property:gts9wifi.spu.nvm=1
+    start spu-secnvm
+    start spu-daemon
+    start hermesd
+
+service spu-secnvm /system/bin/sec_nvm
+    user root
+    group root system
+    setenv LD_LIBRARY_PATH /vendor/lib64:/system/lib64
+    disabled
+    oneshot
+    seclabel u:r:recovery:s0
+
+service spu-daemon /system/bin/spdaemon
+    user root
+    group root system
+    setenv LD_LIBRARY_PATH /vendor/lib64:/system/lib64
+    disabled
+    oneshot
+    seclabel u:r:recovery:s0
+
+service hermesd /system/bin/hermesd /tmp/hermes
+    user root
+    group root system
+    socket hermes_secnvm stream 660 system system
+    setenv LD_LIBRARY_PATH /vendor/lib64:/system/lib64
+    disabled
+    seclabel u:r:recovery:s0
diff --git a/recovery/root/system/bin/gts9wifi-spu-nvm.sh b/recovery/root/system/bin/gts9wifi-spu-nvm.sh
new file mode 100755
index 0000000..20901cd
--- /dev/null
+++ b/recovery/root/system/bin/gts9wifi-spu-nvm.sh
@@ -0,0 +1,13 @@
+#!/system/bin/sh
+# The SPU's NVM (secnvm/ and iar_db/) lives on Android's persist
+# partition.  Recovery gives sec_nvm and spdaemon a copy in tmpfs:
+# persist is mounted read-only with noload (no journal replay, nothing
+# is written), copied, and unmounted.  Whatever the SPU writes during this
+# recovery session stays in RAM; Android's own NVM is not changed.
+mkdir -p /tmp/persist-ro /mnt/vendor/persist /mnt/vendor/spunvm /tmp/hermes || exit 1
+mount -t ext4 -o ro,noload /dev/block/bootdevice/by-name/persist /tmp/persist-ro || exit 1
+cp -a /tmp/persist-ro/secnvm /tmp/persist-ro/iar_db /mnt/vendor/persist/
+ok=$?
+umount /tmp/persist-ro
+[ $ok = 0 ] && [ -d /mnt/vendor/persist/secnvm ] || exit 1
+setprop gts9wifi.spu.nvm 1
