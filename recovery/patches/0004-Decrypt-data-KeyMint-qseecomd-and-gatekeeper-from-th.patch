diff --git a/BoardConfig.mk b/BoardConfig.mk
index 7803330..ed88679 100644
--- a/BoardConfig.mk
+++ b/BoardConfig.mk
@@ -154,6 +154,13 @@ OF_ENABLE_LPTOOLS := 1
 OF_FLASHLIGHT_ENABLE := 0
 OF_USE_GREEN_LED := 0
 OF_ALLOW_DISABLE_NAVBAR := 0
-# No /data decryption in this build (Samsung keymint with wrapped keys is a
-# separate step): do not wait for or prompt for it.
-OF_SKIP_FBE_DECRYPTION := 1
+# /data decryption: FBE v2 with hardware-wrapped keys and metadata
+# encryption (LineageOS 22). Services and libraries are this tablet's own
+# (vendor X710XXU4BXHB) in recovery/root; device/qcom/twrp-common starts
+# qseecomd and gatekeeper, init.recovery.keymint.rc starts KeyMint.
+TW_INCLUDE_CRYPTO := true
+TW_INCLUDE_CRYPTO_FBE := true
+TW_INCLUDE_FBE_METADATA_DECRYPT := true
+BOARD_USES_METADATA_PARTITION := true
+BOARD_USES_QCOM_FBE_DECRYPTION := true
+TW_USE_FSCRYPT_POLICY := 2
diff --git a/device.mk b/device.mk
index 07bf8a8..8c4a059 100644
--- a/device.mk
+++ b/device.mk
@@ -9,3 +9,8 @@ LOCAL_PATH := device/samsung/gts9wifi
 
 # Dynamic partitions
 PRODUCT_USE_DYNAMIC_PARTITIONS := true
+
+# /data decryption (device/qcom/twrp-common)
+PRODUCT_PACKAGES += \
+    qcom_decrypt \
+    qcom_decrypt_fbe
diff --git a/recovery/root/init.recovery.keymint.rc b/recovery/root/init.recovery.keymint.rc
new file mode 100644
index 0000000..24c0e48
--- /dev/null
+++ b/recovery/root/init.recovery.keymint.rc
@@ -0,0 +1,18 @@
+# Samsung/Qualcomm KeyMint for /data decryption in recovery.
+# device/qcom/twrp-common starts qseecomd and gatekeeper but knows only the
+# HIDL keymaster services; this tablet's vendor has the AIDL KeyMint
+# service (with Samsung's libskeymint10device), started the same way:
+# once qseecomd has registered its listeners, stopped after decryption.
+
+service keymint-qti /system/bin/android.hardware.security.keymint-service-qti
+    user root
+    group root drmrpc
+    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib:/system/lib64:/system/lib
+    disabled
+    seclabel u:r:recovery:s0
+
+on property:vendor.sys.listeners.registered=true
+    start keymint-qti
+
+on property:twrp.all.users.decrypted=true
+    stop keymint-qti
