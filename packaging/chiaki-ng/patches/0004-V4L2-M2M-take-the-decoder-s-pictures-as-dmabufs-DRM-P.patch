From 54c64a8ea9b72bfa3b03adceebec7cda2629777e Mon Sep 17 00:00:00 2001
From: ygecesefa <ygecesefa@gmail.com>
Date: Sun, 15 Nov 2026 02:46:13 +0300
Subject: [PATCH] V4L2 M2M: take the decoder's pictures as dmabufs (DRM PRIME),
 no copies

FFmpeg's V4L2 M2M decoders return a copy of every picture in system
memory, which the renderer then uploads to the GPU: two passes over each
1080p frame, measured on a Galaxy Tab S9 at ~4.5 % of one core each at
60 fps.  With the DRM PRIME patch in FFmpeg (ffmpeg-patches/ in this
build) the decoder also offers AV_PIX_FMT_DRM_PRIME: the frame points at
the decoder's own buffer as a dmabuf, and libplacebo (pl_map_avframe_ex)
imports it into Vulkan as it is.

- ffmpegdecoder: a get_format callback picks DRM PRIME when the decoder
  offers it (CHIAKI_V4L2M2M_COPY=1 in the environment keeps the copies).
- qmlbackend: DRM PRIME frames may go to the Vulkan renderer directly,
  like VAAPI ones.  With "zero copy" off, or after a failed import
  (existing fallback), they are transferred to software as before.
- qmlmainwindow: no software snapshot of every DRM PRIME frame for the
  "last frame" picture; the kept frame holds the decoder's buffer.
---
 gui/src/qmlbackend.cpp    |  3 +++
 gui/src/qmlmainwindow.cpp |  8 +++++++-
 lib/src/ffmpegdecoder.c   | 17 +++++++++++++++++
 3 files changed, 27 insertions(+), 1 deletion(-)

diff --git a/gui/src/qmlbackend.cpp b/gui/src/qmlbackend.cpp
index 3fb19475..6a6d8d16 100644
--- a/gui/src/qmlbackend.cpp
+++ b/gui/src/qmlbackend.cpp
@@ -206,6 +206,9 @@ static bool frame_can_use_direct_render(const AVFrame *frame, bool use_opengl_re
 #ifdef Q_OS_LINUX
     case AV_PIX_FMT_VAAPI:
         return !use_opengl_renderer;
+    // dmabuf frames of a V4L2 M2M decoder: libplacebo imports them into Vulkan
+    case AV_PIX_FMT_DRM_PRIME:
+        return !use_opengl_renderer;
 #endif
     default:
         return false;
diff --git a/gui/src/qmlmainwindow.cpp b/gui/src/qmlmainwindow.cpp
index c7986729..8a2ca6dd 100644
--- a/gui/src/qmlmainwindow.cpp
+++ b/gui/src/qmlmainwindow.cpp
@@ -2292,6 +2292,11 @@ static AVFrame *make_fallback_snapshot_frame(const AVFrame *frame)
 
     if (!frame->hw_frames_ctx || frame->format == AV_PIX_FMT_VULKAN)
         return nullptr;
+    // A dmabuf frame stays valid as long as it is referenced (the kept frame
+    // holds the decoder's buffer): a software copy of every frame would undo
+    // what the dmabuf saves.
+    if (frame->format == AV_PIX_FMT_DRM_PRIME)
+        return nullptr;
 
     AVFrame *copy = av_frame_alloc();
     if (!copy)
@@ -4123,7 +4128,8 @@ void QmlMainWindow::snapshotLastFrame(AVFrame *frame, double pts, float duration
         stored = true;
         reason = "stored";
         fallback_frame = fallback_clone;
-        if (!fallback_clone && frame->hw_frames_ctx && frame->format != AV_PIX_FMT_VULKAN)
+        if (!fallback_clone && frame->hw_frames_ctx && frame->format != AV_PIX_FMT_VULKAN &&
+            frame->format != AV_PIX_FMT_DRM_PRIME)
             qCWarning(chiakiGui) << "snapshotLastFrame: failed to create fallback frame";
     }
     snapshot_generation.fetchAndAddRelaxed(1);
diff --git a/lib/src/ffmpegdecoder.c b/lib/src/ffmpegdecoder.c
index 57590593..aa5e35b3 100644
--- a/lib/src/ffmpegdecoder.c
+++ b/lib/src/ffmpegdecoder.c
@@ -5,6 +5,7 @@
 #include <libavutil/mem.h>
 #include <libavutil/pixdesc.h>
 #include <math.h>
+#include <stdlib.h>
 #include <string.h>
 
 static enum AVCodecID chiaki_codec_av_codec_id(ChiakiCodec codec)
@@ -27,6 +28,21 @@ static double chiaki_ffmpeg_decoder_default_frame_duration_us(unsigned int max_f
 	return 1000000.0 / fps;
 }
 
+// FFmpeg's V4L2 M2M decoders return copies of the pictures in system memory.
+// With the DRM PRIME patch (Lukas Rusak's series, carried by LibreELEC; in
+// this build's FFmpeg) they also offer AV_PIX_FMT_DRM_PRIME: the frame then
+// points at the decoder's own buffer as a dmabuf, which the renderer
+// (libplacebo, pl_map_avframe_ex) imports into Vulkan without a copy.
+// CHIAKI_V4L2M2M_COPY=1 in the environment keeps the copies.
+static enum AVPixelFormat v4l2m2m_get_format(AVCodecContext *ctx, const enum AVPixelFormat *fmts)
+{
+	if(!getenv("CHIAKI_V4L2M2M_COPY"))
+		for(const enum AVPixelFormat *p = fmts; *p != AV_PIX_FMT_NONE; p++)
+			if(*p == AV_PIX_FMT_DRM_PRIME)
+				return *p;
+	return avcodec_default_get_format(ctx, fmts);
+}
+
 CHIAKI_EXPORT ChiakiErrorCode chiaki_ffmpeg_decoder_init(ChiakiFfmpegDecoder *decoder, ChiakiLog *log,
 		ChiakiCodec codec, unsigned int width, unsigned int height, unsigned int max_fps,
 		const char *hw_decoder_name, AVBufferRef *hw_device_ctx,
@@ -137,6 +153,7 @@ CHIAKI_EXPORT ChiakiErrorCode chiaki_ffmpeg_decoder_init(ChiakiFfmpegDecoder *de
 	{
 		decoder->codec_context->width = width;
 		decoder->codec_context->height = height;
+		decoder->codec_context->get_format = v4l2m2m_get_format;
 	}
 	decoder->codec_context->framerate = decoder->synthetic_framerate;
 	decoder->codec_context->pkt_timebase = decoder->synthetic_time_base;
-- 
