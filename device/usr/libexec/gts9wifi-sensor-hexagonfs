#!/bin/sh
# Build the HexagonFS tree the ADSP sensor protection domain reads, from this
# tablet's own Android partitions (vendor and dsp, both mounted read-only).
#
#   gts9wifi-sensor-hexagonfs [TREE]   default /usr/share/qcom/sm8550/Samsung/gts9wifi
#
# Adapted from stage-stock-sensor-hexagonfs.sh of the S9 Ultra postmarketOS
# port.  The layout is the one hexagonrpcd + Samsung's registry patch expect:
#   dsp/adsp/*_skel.so   DSP-side skeletons from the dsp partition
#   sensors/config       Samsung's sensor JSONs from /vendor/etc/sensors/config
#   sensors/registry     generated by sscregistrygen, plus the completion marker
#                        and the timestamp cache Samsung's service checks
#   socinfo              board identity the JSONs select on (SM8550 MTP, 519)
# Every timestamp is normalised to the epoch, because the DSP compares each
# JSON's mtime with the cached value and rebuilds the registry otherwise.
set -eu

tree=${1:-/usr/share/qcom/sm8550/Samsung/gts9wifi}
vendor=/vendor
dsp=/vendor/dsp

[ -f "$vendor/etc/sensors/sns_reg_config" ] || { echo "vendor not mounted at $vendor" >&2; exit 1; }
[ -d "$dsp/adsp" ] || { echo "dsp not mounted at $dsp" >&2; exit 1; }
command -v sscregistrygen >/dev/null || { echo "sscregistrygen missing (hexagonrpcd package)" >&2; exit 1; }

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
root=$tmp/tree
mkdir -p "$root/dsp/adsp" "$root/sensors/config" "$root/sensors/registry" "$root/socinfo"

cp -a "$vendor/etc/sensors/config/." "$root/sensors/config/"
sscregistrygen -p MTP -s 519 "$root/sensors/config" "$root/sensors/registry"
cp "$vendor/etc/sensors/sns_reg_config" "$root/sensors/sns_reg.conf"
: >"$root/sensors/registry/sensors_registry"
python3 - "$root/sensors/config" "$root/sensors/registry/sns_reg_config" <<'PY'
import json, pathlib, sys
config, output = pathlib.Path(sys.argv[1]), pathlib.Path(sys.argv[2])
entries = {f"/vendor/etc/sensors/config/{p.name}": {"type": "int", "ver": "0", "data": "0"}
           for p in sorted(config.glob("*.json"))}
output.write_text(json.dumps({"sns_reg_config": {"owner": "NA", **entries}}, separators=(",", ":")))
PY
printf 'version=6\0' >"$root/sensors/sns_reg_version"

printf '%s\n' MTP >"$root/socinfo/hw_platform"
printf '%s\n' 519 >"$root/socinfo/soc_id"
printf '%s\n' 0 >"$root/socinfo/platform_subtype"
printf '%s\n' 0 >"$root/socinfo/platform_subtype_id"
printf '%s\n' 0 >"$root/socinfo/platform_version"

for f in libsns_device_mode_skel.so libsns_direct_channel_skel.so \
	libsns_dynamic_loader_skel.so libsns_remote_proc_state_skel.so sns_tppe.so; do
	[ -f "$dsp/adsp/$f" ] || { echo "missing $dsp/adsp/$f" >&2; exit 1; }
	cp "$dsp/adsp/$f" "$root/dsp/adsp/$f"
done

find "$root" -exec touch -h -d @0 {} +
rm -rf "$tree.new"
mkdir -p "$(dirname "$tree")"
cp -a "$root" "$tree.new"
(cd "$tree.new" && find . -type f -print0 | sort -z | xargs -0 sha256sum) > "$tree.new.SHA256SUMS"
rm -rf "$tree"
mv "$tree.new" "$tree"
mv "$tree.new.SHA256SUMS" "$tree.SHA256SUMS"
echo "HexagonFS tree: $tree ($(find "$tree" -type f | wc -l) files, checksums in $tree.SHA256SUMS)"
