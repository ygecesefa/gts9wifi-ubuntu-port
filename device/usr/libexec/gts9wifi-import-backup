#!/usr/bin/python3
"""Install this tablet's fingerprint calibration from the microSD.

The sensor's factory calibration (calib.dat, egoptbds.dat) exists only in
Android's /data/vendor, which a recovery cannot read.  From Android, the
installer zip (installed through the Magisk app), the Magisk module and
to-ubuntu.sh put it on the card's FAT partition GTS9W_BACK:

  fingerprint/calib.dat, egoptbds.dat, SHA256SUMS

At boot this checks the sha256 and installs both files into
/var/lib/gts9wifi/fingerprint/firmware.  The unit runs only while one of
them is missing there (ConditionPathExists), so once the calibration is in
place it stops running.  GTS9W_BACK is mounted read-only; nothing is ever
written to it.

The Android boot images are not copied any more: "Switch to Android"
(ubuntu-to-android) reads GTS9W_BACK/android-restore.zip itself.
"""
import hashlib
import os
import subprocess
import sys
import tempfile
from pathlib import Path

LABEL = Path('/dev/disk/by-label/GTS9W_BACK')
FP_FIRMWARE = Path('/var/lib/gts9wifi/fingerprint/firmware')
FP_FILES = ('calib.dat', 'egoptbds.dat')


def log(msg):
    print(f'gts9wifi-import-backup: {msg}', flush=True)


def sha256(data):
    return hashlib.sha256(data).hexdigest()


def sums(text):
    out = {}
    for line in text.splitlines():
        parts = line.split()
        if len(parts) == 2:
            out[parts[1].lstrip('*')] = parts[0]
    return out


def install(dest, name, data, mode=0o600):
    tmp = dest / f'.{name}.new'
    with open(tmp, 'wb') as f:
        f.write(data)
        f.flush()
        os.fsync(f.fileno())
    os.chmod(tmp, mode)
    os.replace(tmp, dest / name)


def import_fingerprint(back):
    d = back / 'fingerprint'
    if not all((d / f).is_file() for f in FP_FILES):
        return
    want = sums((d / 'SHA256SUMS').read_text()) if (d / 'SHA256SUMS').is_file() else {}
    for f in FP_FILES:
        data = (d / f).read_bytes()
        if f in want and sha256(data) != want[f]:
            log(f'fingerprint/{f} does not match its SHA256SUMS; skipped')
            continue
        target = FP_FIRMWARE / f
        if target.is_file() and sha256(target.read_bytes()) == sha256(data):
            continue
        FP_FIRMWARE.mkdir(mode=0o700, parents=True, exist_ok=True)
        install(FP_FIRMWARE, f, data)
        log(f'fingerprint calibration {f} installed')


def main():
    if not LABEL.exists():
        log('no GTS9W_BACK partition (older card layout); nothing to do')
        return 0
    with tempfile.TemporaryDirectory(prefix='gts9w-back-') as mnt:
        subprocess.run(['mount', '-t', 'vfat', '-o', 'ro,nosuid,nodev,noexec',
                        str(LABEL.resolve()), mnt], check=True)
        try:
            back = Path(mnt)
            import_fingerprint(back)
        finally:
            subprocess.run(['umount', mnt], check=False)
    return 0


if __name__ == '__main__':
    sys.exit(main())
