#!/bin/bash
# Give the WCN6855 Wi-Fi its unit-specific MAC address.
#
# The board data carries no MAC address, so ath11k makes one up at every
# boot (00:03:7f:…, Qualcomm's prefix): the router then sees a new device
# and hands out a new IP address each time.  Android's address lives in
# Samsung's EFS (wifi/.mac.info).  EFS is only ever mounted read-only and
# nothing on disk is written.
#
# Runs once per boot before NetworkManager (gts9wifi-wifi-address.service)
# and hands the address to it in /run: NetworkManager sets it on the ath11k
# interface at every activation, also after a Wi-Fi firmware recovery.
# (From a udev rule the mount fails: udevd has no CAP_SYS_ADMIN.)
set -euo pipefail

EFS=/dev/disk/by-partlabel/efs
CONF=/run/NetworkManager/conf.d/50-gts9wifi-wifi-address.conf

mnt=$(mktemp -d /run/gts9wifi-efs.XXXXXX)
trap 'umount "$mnt" 2>/dev/null || true; rmdir "$mnt"' EXIT
mount -o ro,noload "$EFS" "$mnt"
addr=$(tr -d '\r\n ' < "$mnt/wifi/.mac.info")
umount "$mnt"

if ! [[ $addr =~ ^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$ ]] || [ "$addr" = 00:00:00:00:00:00 ]; then
	echo "invalid Wi-Fi address in EFS" >&2
	exit 1
fi

mkdir -p "$(dirname "$CONF")"
cat > "$CONF" <<EOF
# Written at boot by gts9wifi-wifi-address from EFS (wifi/.mac.info).
[connection-gts9wifi-wifi-address]
match-device=driver:ath11k_pci
wifi.cloned-mac-address=${addr,,}
EOF
echo "Wi-Fi address from EFS (…${addr: -5}) handed to NetworkManager"
