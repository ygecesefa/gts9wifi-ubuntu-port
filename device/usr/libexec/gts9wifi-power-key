#!/usr/bin/python3
# Power key for the GNOME session on the Tab S9 (X710), like Android:
#   short press  -> suspend
#   hold 0.7 s   -> GNOME's power-off dialog (Restart / Power Off)
# GNOME's own handling is off (power-button-action='nothing') because it acts
# on key-down, before a long press can be told apart.  The press that wakes
# the tablet reaches us after resume; it is recognised and dropped, so waking
# does not suspend again: time was spent suspended since the last press
# (BOOTTIME - MONOTONIC grew; the kernel updates it before tasks thaw, unlike
# suspend_stats) and the wake IRQ was the power key's.
#
# A press while the screen is off, or within WAKE_GRACE_MS after it came on
# (Mutter's PowerSaveMode), only wakes the screen.  GNOME blanks a locked
# screen after a short idle without suspending: the press then turned the
# screen on (Mutter) and suspended (the lock screen was "active").
#
# A press that comes while a suspend is on its way (logind's PrepareForSleep
# was sent) or within WAKE_GRACE_MS after the resume is the press that wakes
# the tablet: it is dropped too.  The suspend takes ~2 s after the screen goes
# dark (lock, then logind); a press in that time aborts it in the kernel, so
# no time was spent asleep and the first test alone took it for a new press
# and suspended again (the screen came on for a moment, then went off).  A
# press while the lock is still being waited for cancels the suspend.
#
# The screen is locked first and the suspend requested once the lock screen
# is up (or after LOCK_WAIT_MS); with GNOME's screen lock turned off
# (org.gnome.desktop.screensaver lock-enabled, a Tab9 Extras switch) it
# suspends at once and waking goes straight back to the desktop.  Locking from logind's PrepareForSleep
# instead stalled: the panel goes dark at once, GNOME's lock animation never
# finishes on it, and gnome-shell's delay inhibitor ran into logind's 5 s
# timeout on every suspend.
import os
import struct
import sys
import time

from gi.repository import Gio, GLib

EVENT = struct.Struct('llHHi')
EV_KEY, KEY_POWER = 1, 116
LONG_MS = 700
LOCK_WAIT_MS = 2000
WAKE_GRACE_MS = 1000


def find_device():
    for name in sorted(os.listdir('/sys/class/input')):
        if not name.startswith('event'):
            continue
        try:
            with open(f'/sys/class/input/{name}/device/name') as f:
                if f.read().strip() == 'pmic_pwrkey':
                    return f'/dev/input/{name}'
        except OSError:
            pass
    return None


def pwrkey_irq():
    with open('/proc/interrupts') as f:
        for line in f:
            if line.rstrip().endswith('pmic_pwrkey'):
                return line.split(':', 1)[0].strip()
    return None


def asleep():
    """Seconds spent suspended since boot."""
    return time.clock_gettime(time.CLOCK_BOOTTIME) - \
        time.clock_gettime(time.CLOCK_MONOTONIC)


def read(path):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return None


class PowerKey:
    def __init__(self, dev):
        self.fd = os.open(dev, os.O_RDONLY | os.O_NONBLOCK)
        self.irq = pwrkey_irq()
        self.asleep = asleep()
        self.timer = 0
        self.ignore_release = False
        self.lock_wait = 0
        self.sleeping = False
        self.resumed = 0.0
        self.screensaver_settings = Gio.Settings.new('org.gnome.desktop.screensaver')
        self.system = Gio.bus_get_sync(Gio.BusType.SYSTEM)
        self.session = Gio.bus_get_sync(Gio.BusType.SESSION)
        self.display_off = False
        self.display_on = 0.0
        self.session.signal_subscribe(
            'org.gnome.Mutter.DisplayConfig', 'org.freedesktop.DBus.Properties',
            'PropertiesChanged', '/org/gnome/Mutter/DisplayConfig', None,
            Gio.DBusSignalFlags.NONE, self.on_display_props)
        try:
            mode = self.session.call_sync(
                'org.gnome.Mutter.DisplayConfig', '/org/gnome/Mutter/DisplayConfig',
                'org.freedesktop.DBus.Properties', 'Get',
                GLib.Variant('(ss)', ('org.gnome.Mutter.DisplayConfig', 'PowerSaveMode')),
                None, Gio.DBusCallFlags.NONE, 1000, None).unpack()[0]
            self.display_off = mode != 0
        except GLib.Error:
            pass
        self.system.signal_subscribe(
            'org.freedesktop.login1', 'org.freedesktop.login1.Manager',
            'PrepareForSleep', '/org/freedesktop/login1', None,
            Gio.DBusSignalFlags.NONE, self.on_prepare_for_sleep)
        GLib.unix_fd_add_full(GLib.PRIORITY_DEFAULT, self.fd,
                              GLib.IOCondition.IN, self.on_input)

    def on_display_props(self, bus, sender, path, iface, signal, args):
        changed = args.unpack()[1]
        if 'PowerSaveMode' not in changed:
            return
        off = changed['PowerSaveMode'] != 0
        if self.display_off and not off:
            self.display_on = time.monotonic()
        self.display_off = off

    def on_prepare_for_sleep(self, bus, sender, path, iface, signal, args):
        self.sleeping = args.unpack()[0]
        if not self.sleeping:
            self.resumed = time.monotonic()

    def woke_by_this_key(self):
        now = time.monotonic()
        if self.sleeping or self.display_off or \
                now - self.resumed < WAKE_GRACE_MS / 1000 or \
                now - self.display_on < WAKE_GRACE_MS / 1000:
            return True
        slept = asleep()
        if slept - self.asleep < 0.05:
            return False
        self.asleep = slept
        return self.irq is not None and \
            read('/sys/power/pm_wakeup_irq') == self.irq

    def on_input(self, fd, cond):
        try:
            data = os.read(fd, EVENT.size * 64)
        except BlockingIOError:
            return True
        for off in range(0, len(data) - EVENT.size + 1, EVENT.size):
            _, _, etype, code, value = EVENT.unpack_from(data, off)
            if etype == EV_KEY and code == KEY_POWER:
                if value == 1:
                    self.pressed()
                elif value == 0:
                    self.released()
        return True

    def pressed(self):
        if self.lock_wait:
            # Pressed again before the tablet went to sleep: stay awake.
            print('press during lock: suspend cancelled', file=sys.stderr, flush=True)
            GLib.source_remove(self.lock_wait)
            self.lock_wait = 0
            self.ignore_release = True
            return
        if self.woke_by_this_key():
            print('wake press dropped', file=sys.stderr, flush=True)
            self.ignore_release = True
            return
        self.cancel()
        self.timer = GLib.timeout_add(LONG_MS, self.long_press)

    def released(self):
        if self.ignore_release:
            self.ignore_release = False
            return
        if self.timer:
            self.cancel()
            self.lock_then_suspend()

    def screensaver(self, method, args=None):
        return self.session.call_sync(
            'org.gnome.ScreenSaver', '/org/gnome/ScreenSaver',
            'org.gnome.ScreenSaver', method, args, None,
            Gio.DBusCallFlags.NONE, 1000, None)

    def lock_then_suspend(self):
        if self.lock_wait:
            return
        if not self.screensaver_settings.get_boolean('lock-enabled'):
            self.suspend()
            return
        try:
            if self.screensaver('GetActive').unpack()[0]:
                self.suspend()
                return
            self.screensaver('SetActive', GLib.Variant('(b)', (True,)))
        except GLib.Error as e:
            print(f'lock failed: {e.message}', file=sys.stderr)
            self.suspend()
            return
        self.lock_waited = 0
        self.lock_wait = GLib.timeout_add(100, self.poll_lock)

    def poll_lock(self):
        self.lock_waited += 100
        try:
            active = self.screensaver('GetActive').unpack()[0]
        except GLib.Error:
            active = False
        if not active and self.lock_waited < LOCK_WAIT_MS:
            return True
        self.lock_wait = 0
        self.suspend()
        return False

    def suspend(self):
        self.call(self.system, 'org.freedesktop.login1',
                  '/org/freedesktop/login1',
                  'org.freedesktop.login1.Manager', 'Suspend',
                  GLib.Variant('(b)', (False,)))

    def long_press(self):
        self.timer = 0
        self.call(self.session, 'org.gnome.SessionManager',
                  '/org/gnome/SessionManager', 'org.gnome.SessionManager',
                  'Shutdown', None)
        return False

    def cancel(self):
        if self.timer:
            GLib.source_remove(self.timer)
            self.timer = 0

    @staticmethod
    def call(bus, name, path, iface, method, args):
        bus.call(name, path, iface, method, args, None,
                 Gio.DBusCallFlags.NONE, -1, None,
                 lambda b, res: PowerKey.done(b, res, method))

    @staticmethod
    def done(bus, res, method):
        try:
            bus.call_finish(res)
        except GLib.Error as e:
            print(f'{method} failed: {e.message}', file=sys.stderr)


def main():
    dev = find_device()
    if dev is None:
        print('pmic_pwrkey input device not found', file=sys.stderr)
        return 1
    PowerKey(dev)
    GLib.MainLoop().run()
    return 0


if __name__ == '__main__':
    sys.exit(main())
