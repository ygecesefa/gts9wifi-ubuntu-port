# gts9wifi device defaults.
#
# Enable the device-controls extension (double tap to wake, fast charging).
# The Ubuntu mode keeps its own extensions (dock, appindicators, ding, tiling)
# separately, so this does not disable them.
[org.gnome.shell]
enabled-extensions=['gnome-gts9wifi@tabs9linux']

# The power key is handled by gts9wifi-power-key (short press suspends, long
# press opens the power menu, as on Android); GNOME acts on key-down and would
# suspend before a long press is seen.
[org.gnome.settings-daemon.plugins.power]
power-button-action='nothing'
