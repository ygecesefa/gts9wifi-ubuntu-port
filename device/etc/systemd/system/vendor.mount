# Android vendor image from super, mapped read-only by
# gts9wifi-android-parts.  ext4 on LineageOS, erofs on other ROMs (HyperOS
# ports): Type=auto, and no ext4-only noload, which erofs rejects.  The
# mapping is read-only, so ext4 can never replay its journal onto it.
[Unit]
Description=Android vendor image (read-only)
Requires=gts9wifi-android-parts.service
After=gts9wifi-android-parts.service
DefaultDependencies=no
Conflicts=umount.target
Before=umount.target local-fs.target

[Mount]
What=/dev/mapper/vendor
Where=/vendor
Type=auto
Options=ro,nodev,nosuid

[Install]
WantedBy=local-fs.target
