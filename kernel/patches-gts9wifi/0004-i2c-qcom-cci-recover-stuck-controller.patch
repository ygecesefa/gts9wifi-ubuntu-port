From: gts9wifi Ubuntu port
Subject: [PATCH] i2c: qcom-cci: recover a controller that stopped running queues

On the X710 the rear camera's CCI (ac15000, master 1) stops running
queues after a quick camera stop/start (GNOME Snapshot taking a
picture): the queue start produces no bus activity at all and no
interrupt, every transfer times out ("master 1 queue 0 timeout") and
the plain reset done on timeout does not bring it back.  Unbinding and
re-binding the driver did.

- log IRQ status/mask and the queue counters on a timeout
- on a timeout halt the master, re-apply the pin states, cycle the
  clocks, then reset and re-initialise the controller (what unbind +
  bind does), so the client can retry
- reset, not only re-initialise, on runtime resume: the camera GDSC may
  have collapsed while the controller was suspended

Result on the tablet: the diagnostics show the master stuck on its WRITE
command (exec 4, cur 1), and even the halt is never acknowledged, so this
in-driver recovery does not bring the controller back; only a power
collapse of the camera GDSC does.  The actual fix is in userspace: the
udev rule 71-gts9wifi-cci-autosuspend.rules suspends the CCI at once, so
the GDSC drops with the sensor.  This patch is kept for the diagnostics
and the reset on resume.
---
--- a/drivers/i2c/busses/i2c-qcom-cci.c	2026-10-18 20:04:38.542190678 +0300
+++ b/drivers/i2c/busses/i2c-qcom-cci.c	2026-10-18 20:39:16.339362556 +0300
@@ -3,12 +3,14 @@
 // Copyright (c) 2017-2022 Linaro Limited.
 
 #include <linux/clk.h>
+#include <linux/delay.h>
 #include <linux/completion.h>
 #include <linux/i2c.h>
 #include <linux/io.h>
 #include <linux/interrupt.h>
 #include <linux/module.h>
 #include <linux/of.h>
+#include <linux/pinctrl/consumer.h>
 #include <linux/platform_device.h>
 #include <linux/pm_runtime.h>
 
@@ -288,6 +290,48 @@
 	return 0;
 }
 
+/*
+ * A queue that never reports leaves the controller unable to run any further
+ * queue: the master sits on its WRITE command with no bus activity and no
+ * interrupt, and a plain reset does not bring it back; only unbinding and
+ * re-binding the driver did.  Do what that path does: halt the master (as
+ * cci_remove() does), re-apply the pin states, cycle the clocks, then reset
+ * and re-initialise the controller, so the client's next transfer can work.
+ */
+static void cci_recover(struct cci *cci, u8 master)
+{
+	struct pinctrl *pins;
+	int halt, ret;
+
+	halt = cci_halt(cci, master);
+
+	pins = pinctrl_get(cci->dev);
+	if (!IS_ERR(pins)) {
+		struct pinctrl_state *sleep = pinctrl_lookup_state(pins, PINCTRL_STATE_SLEEP);
+		struct pinctrl_state *def = pinctrl_lookup_state(pins, PINCTRL_STATE_DEFAULT);
+
+		if (!IS_ERR(sleep) && !IS_ERR(def)) {
+			pinctrl_select_state(pins, sleep);
+			usleep_range(1000, 1500);
+			pinctrl_select_state(pins, def);
+		}
+		pinctrl_put(pins);
+	}
+
+	disable_irq(cci->irq);
+	clk_bulk_disable_unprepare(cci->nclocks, cci->clocks);
+	usleep_range(1000, 1500);
+	ret = clk_bulk_prepare_enable(cci->nclocks, cci->clocks);
+	enable_irq(cci->irq);
+	if (ret) {
+		dev_err(cci->dev, "recovery: clocks did not come back: %d\n", ret);
+		return;
+	}
+	ret = cci_reset(cci);
+	dev_warn(cci->dev, "recovered master %u after timeout (halt %d, reset %d)\n",
+		 master, halt, ret);
+}
+
 static int cci_run_queue(struct cci *cci, u8 master, u8 queue)
 {
 	u32 val;
@@ -301,9 +345,16 @@
 
 	if (!wait_for_completion_timeout(&cci->master[master].irq_complete,
 					 CCI_TIMEOUT)) {
-		dev_err(cci->dev, "master %d queue %d timeout\n",
-			master, queue);
-		cci_reset(cci);
+		dev_err(cci->dev,
+			"master %d queue %d timeout (irq 0x%08x mask 0x%08x exec %u cur %u cmd 0x%08x report 0x%08x)\n",
+			master, queue,
+			readl(cci->base + CCI_IRQ_STATUS_0),
+			readl(cci->base + CCI_IRQ_MASK_0),
+			readl(cci->base + CCI_I2C_Mm_Qn_EXEC_WORD_CNT(master, queue)),
+			readl(cci->base + CCI_I2C_Mm_Qn_CUR_WORD_CNT(master, queue)),
+			readl(cci->base + CCI_I2C_Mm_Qn_CUR_CMD(master, queue)),
+			readl(cci->base + CCI_I2C_Mm_Qn_REPORT_STATUS(master, queue)));
+		cci_recover(cci, master);
 		return -ETIMEDOUT;
 	}
 
@@ -488,7 +539,13 @@
 	if (ret)
 		return ret;
 
-	cci_init(cci);
+	/*
+	 * The camera GDSC may have collapsed while the controller was
+	 * suspended; re-initialising the registers alone is not enough then.
+	 */
+	ret = cci_reset(cci);
+	if (ret)
+		cci_init(cci);
 	return 0;
 }
 
