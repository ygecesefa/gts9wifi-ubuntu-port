From: gts9wifi Ubuntu port
Subject: [PATCH] media: hi1337-gts9u: minimum off time, retry a failed stream start

GNOME Snapshot stops and restarts the rear stream within a few hundred
milliseconds when it takes a picture.  Powering the sensor straight back
up made the first register write time out (CCI "master 1 queue 0
timeout", -110 writing 0x0790): the stream never started and the
application hung.  Keep the sensor unpowered for at least 50 ms, and on
an I2C timeout power-cycle it and try again (three attempts).
---
--- a/drivers/media/i2c/hi1337_gts9u.c	2026-10-18 18:15:52.491050917 +0300
+++ b/drivers/media/i2c/hi1337_gts9u.c	2026-10-18 18:15:32.950198113 +0300
@@ -3,6 +3,7 @@
 
 #include <linux/clk.h>
 #include <linux/delay.h>
+#include <linux/ktime.h>
 #include <linux/gpio/consumer.h>
 #include <linux/i2c.h>
 #include <linux/module.h>
@@ -105,6 +106,7 @@
 	struct v4l2_ctrl *exposure;
 	struct v4l2_async_notifier notifier;
 	struct mutex mutex;
+	ktime_t powered_off;
 	bool streaming;
 };
 
@@ -169,10 +171,24 @@
 	return 0;
 }
 
+/*
+ * Minimum time the sensor stays unpowered before it is powered again.  A
+ * stop immediately followed by a start (GNOME Snapshot reconfigures the
+ * stream when it takes a picture) otherwise powers the sensor back up before
+ * its rails have discharged, and the first register write times out.
+ */
+#define HI1337_OFF_TIME_MS	50
+#define HI1337_START_ATTEMPTS	3
+
 static int hi1337_power_on(struct hi1337 *sensor)
 {
+	s64 off_ms;
 	int ret;
 
+	off_ms = ktime_ms_delta(ktime_get(), sensor->powered_off);
+	if (off_ms >= 0 && off_ms < HI1337_OFF_TIME_MS)
+		msleep(HI1337_OFF_TIME_MS - off_ms);
+
 	ret = regulator_bulk_enable(ARRAY_SIZE(sensor->supplies),
 				    sensor->supplies);
 	if (ret)
@@ -242,6 +258,7 @@
 		gpiod_put(sensor->enable_gpio);
 	sensor->enable_gpio = NULL;
 	regulator_bulk_disable(ARRAY_SIZE(sensor->supplies), sensor->supplies);
+	sensor->powered_off = ktime_get();
 }
 
 static int hi1337_identify(struct hi1337 *sensor)
@@ -408,12 +425,21 @@
 		goto unlock;
 
 	if (enable) {
-		ret = hi1337_power_on(sensor);
-		if (ret)
-			goto unlock;
-		ret = hi1337_start_streaming(sensor);
-		if (ret)
+		unsigned int attempt;
+
+		for (attempt = 1; attempt <= HI1337_START_ATTEMPTS; attempt++) {
+			ret = hi1337_power_on(sensor);
+			if (ret)
+				goto unlock;
+			ret = hi1337_start_streaming(sensor);
+			if (!ret)
+				break;
 			hi1337_power_off(sensor);
+			if (ret != -ETIMEDOUT && ret != -EREMOTEIO && ret != -EIO)
+				break;
+			dev_warn(sensor->dev, "stream start failed (%d), power cycle %u/%u\n",
+				 ret, attempt, HI1337_START_ATTEMPTS);
+		}
 	} else {
 		ret = hi1337_write_reg(sensor, HI1337_REG_MODE_SELECT,
 				       HI1337_MODE_STANDBY);
